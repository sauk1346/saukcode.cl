---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import Footer from '../components/layout/Footer.astro';
import SearchModal from '../components/layout/SearchModal.astro';

const {
  title = 'SaukCode',
  description = 'Plataforma personal de recopilación de contenido académico',
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <title>{title}</title>
    <!-- Anti-FOUC: aplica el tema antes del primer paint -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var dark = saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) {
            // 'dark' para Tailwind; 'dark-mode-override' para los CSS modules portados del sitio Next
            document.documentElement.classList.add('dark', 'dark-mode-override');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Navbar />
    <Breadcrumb />
    <main class="flex-1" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <SearchModal />
    <script is:inline>
      // Reloj global de parpadeo en 3 fases (plena → media → tenue →
      // media): todos los intermitentes laten al mismo tic. Apagado con
      // prefers-reduced-motion.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var blinkPhase = 0;
        setInterval(function () {
          blinkPhase = (blinkPhase + 1) % 4;
          document.documentElement.dataset.blink = String(blinkPhase);
        }, 350);
      }
    </script>
  </body>
</html>
