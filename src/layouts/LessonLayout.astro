---
// Layout de lección: replica Container + MDXWrapper (contenido + sidebar con
// TableOfContents) del sitio Next.
import '../styles/code-theme.css';
import '../styles/components.css';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/common/TableOfContents.jsx';
import wrapperStyles from '../components/common/MDXWrapper.module.css';
import containerStyles from '../components/mdx/Container.module.css';

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <!-- Progreso de lectura: barra de energía de 20 celdas con niveles -->
  <div id="reading-progress" aria-hidden="true">
    {Array.from({ length: 20 }).map(() => <span></span>)}
  </div>
  <!-- Recompensa por completar la lección (1UP arcade) -->
  <div id="reading-1up" aria-hidden="true">1UP</div>
  <div class={wrapperStyles.mdxLayout}>
    <main class={wrapperStyles.mdxContent}>
      <div class={containerStyles.container}>
        <slot />
      </div>
    </main>
    <aside class={wrapperStyles.mdxSidebar}>
      <TableOfContents client:idle />
    </aside>
  </div>
</BaseLayout>

<style is:global>
  #reading-progress {
    position: fixed;
    top: 3.5rem; /* bajo el navbar (h-14) */
    left: 0;
    right: 0;
    display: flex;
    gap: 2px;
    padding: 0 2px;
    height: 8px;
    z-index: 40;
    pointer-events: none;
  }

  /* 1UP: texto pixel que flota y se desvanece, como la vida extra */
  #reading-1up {
    position: fixed;
    top: 5rem;
    right: 1.25rem; /* brota de la punta de la barra, que remata aquí */
    z-index: 41;
    font-family: var(--font-pixel);
    font-size: 1.75rem;
    color: var(--success);
    text-shadow: 3px 3px 0 var(--shadow-hard);
    pointer-events: none;
    opacity: 0;
  }

  #reading-1up.show {
    animation: oneUp 1.6s steps(8) forwards;
  }

  @keyframes oneUp {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(-40px);
    }
  }

  #reading-progress span {
    flex: 1;
    background-color: color-mix(in srgb, var(--secondary) 22%, transparent);
  }

  /* Nivel según avance: rojo al partir, dorado a mitad, verde al cierre */
  #reading-progress.tier-low span.filled {
    background-color: var(--error);
  }

  #reading-progress.tier-mid span.filled {
    background-color: var(--warning-fill);
  }

  #reading-progress.tier-high span.filled {
    background-color: var(--success);
  }

  /* La punta late con el reloj global */
  html[data-blink='1'] #reading-progress span.tip,
  html[data-blink='3'] #reading-progress span.tip {
    opacity: 0.7;
  }

  html[data-blink='2'] #reading-progress span.tip {
    opacity: 0.4;
  }
</style>

<script>
  // Barra de energía de lectura: 20 celdas, nivel por tramo y punta latiendo
  const progressBar = document.getElementById('reading-progress');
  const progressCells = progressBar ? Array.from(progressBar.children) : [];
  const oneUp = document.getElementById('reading-1up');
  let oneUpArmed = true; // se rearma al bajar del 60%: celebra cada cruce real
  const updateProgress = () => {
    if (!progressBar) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
    const filled = Math.round(p * 20);
    progressBar.classList.remove('tier-low', 'tier-mid', 'tier-high');
    progressBar.classList.add(filled >= 14 ? 'tier-high' : filled >= 7 ? 'tier-mid' : 'tier-low');
    progressCells.forEach((cell, i) => {
      cell.classList.toggle('filled', i < filled);
      // al 100% la barra descansa sólida: el latido es 'cargando'
      cell.classList.toggle('tip', i === filled - 1 && filled < 20);
    });
    // Vida extra al completar; se rearma al volver bajo el 60%
    if (filled < 12) oneUpArmed = true;
    if (filled === 20 && oneUpArmed && oneUp) {
      oneUpArmed = false;
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        oneUp.classList.remove('show');
        void oneUp.offsetWidth; // reinicia la animación
        oneUp.classList.add('show');
      }
    }
  };
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress, { passive: true });

  // Save state para el "▶ Continuar" de la portada
  try {
    localStorage.setItem(
      'saukcode:ultima-leccion',
      JSON.stringify({ url: location.pathname, title: document.title.replace(/ \| SaukCode$/, '') })
    );
  } catch (e) {}

  // :reveal[...] — alterna la respuesta oculta (delegación de eventos)
  document.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement).closest('.reveal');
    if (!button) return;
    const shown = button.getAttribute('aria-pressed') !== 'true';
    button.setAttribute('aria-pressed', String(shown));
    button.setAttribute('aria-label', shown ? 'Ocultar respuesta' : 'Mostrar respuesta');
  });

  // ::::solution — despliegue animado donde el CSS no puede (sin interpolate-size:
  // Firefox, Safari). Anima altura y padding del contenido y recién al cerrar
  // quita `open`, para que el contenido siga visible durante la animación.
  if (!CSS.supports('interpolate-size', 'allow-keywords')) {
    document.addEventListener('click', (e) => {
      const summary = (e.target as HTMLElement).closest('details.solution > summary');
      if (!summary || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const details = summary.parentElement as HTMLDetailsElement;
      const content = details.querySelector<HTMLElement>(':scope > .solution-content');
      if (!content) return;
      e.preventDefault();
      if (details.dataset.animating) return;

      const opening = !details.open;
      details.open = true;
      const { height, paddingTop, paddingBottom } = getComputedStyle(content);
      const shown = { height, paddingTop, paddingBottom };
      const hidden = { height: '0px', paddingTop: '0px', paddingBottom: '0px' };
      details.dataset.animating = 'true';
      content.style.overflow = 'hidden';
      content.animate(opening ? [hidden, shown] : [shown, hidden], {
        duration: 400,
        easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
      }).onfinish = () => {
        if (!opening) details.open = false;
        content.style.overflow = '';
        delete details.dataset.animating;
      };
    });
  }

</script>
