---
// Breadcrumb server-rendered desde la URL — reemplaza el componente cliente
// de Next (usePathname + lógica de compresión); el overflow se maneja con CSS.
const parts = Astro.url.pathname.split('/').filter(Boolean);
---

{parts.length > 0 && (
  <nav aria-label="Breadcrumb" class="mx-auto w-full max-w-6xl overflow-x-auto px-4 py-2">
    <!-- La ruta se muestra como path de terminal: mono + separador ▸ -->
    <ol class="font-mono flex items-center gap-1.5 text-[13px] whitespace-nowrap">
      <li>
        <a href="/" class="text-(--secondary) underline-offset-2 hover:text-(--primary) hover:underline">inicio</a>
      </li>
      {parts.map((part, index) => {
        const path = `/${parts.slice(0, index + 1).join('/')}`;
        const isLast = index === parts.length - 1;
        return (
          <>
            <li aria-hidden="true" class="text-(--secondary) opacity-50">▸</li>
            <li>
              {isLast ? (
                <span
                  aria-current="page"
                  class="border border-(--border-color) bg-(--surface) px-1.5 py-0.5 text-(--foreground)"
                >
                  {part}
                </span>
              ) : (
                <a href={path} class="text-(--secondary) underline-offset-2 hover:text-(--primary) hover:underline">{part}</a>
              )}
            </li>
          </>
        );
      })}
    </ol>
  </nav>
)}
