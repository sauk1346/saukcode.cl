---
// Búsqueda del sitio con Pagefind: el índice se genera en postbuild sobre
// dist/, así que en `npm run dev` no existe (el modal lo avisa). La UI se
// carga perezosamente la primera vez que se abre el modal.
---

<dialog
  id="search-modal"
  class="m-auto w-[min(640px,92vw)] border-2 border-(--foreground) bg-(--background-elevated) p-4 text-(--foreground) shadow-(--shadow-lg) backdrop:bg-black/60"
>
  <div class="mb-3 flex items-center justify-between">
    <span class="font-pixel text-sm">BUSCAR</span>
    <button id="search-close" class="pixel-press font-mono border border-(--border-color) bg-(--surface) px-2 py-1 text-xs text-(--secondary) hover:text-(--foreground)" aria-label="Cerrar búsqueda">
      Esc ✕
    </button>
  </div>
  <div id="search-container"></div>
  <p id="search-dev-note" class="hidden text-sm text-(--secondary)">
    El índice de búsqueda se genera con <code>npm run build</code>; no está disponible en el servidor de desarrollo.
  </p>
</dialog>

<script is:inline>
  (function () {
    var modal = document.getElementById('search-modal');
    var loaded = false;

    function focusInput() {
      var input = modal.querySelector('input');
      if (input) {
        input.focus();
        input.select();
      }
    }

    async function openSearch() {
      modal.showModal();
      if (loaded) {
        setTimeout(focusInput, 0);
        return;
      }
      loaded = true;
      try {
        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = '/pagefind/pagefind-ui.css';
        document.head.appendChild(css);
        // pagefind-ui.js es un script clásico que define window.PagefindUI
        await new Promise(function (resolve, reject) {
          var s = document.createElement('script');
          s.src = '/pagefind/pagefind-ui.js';
          s.onload = resolve;
          s.onerror = reject;
          document.head.appendChild(s);
        });
        new window.PagefindUI({
          element: '#search-container',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: 'Buscar apuntes, ejercicios, ramos…',
            zero_results: 'Sin resultados para [SEARCH_TERM]',
          },
        });
        setTimeout(focusInput, 50);
      } catch (e) {
        document.getElementById('search-dev-note').classList.remove('hidden');
      }
    }

    document.querySelectorAll('.js-open-search').forEach(function (btn) {
      btn.addEventListener('click', openSearch);
    });
    document.getElementById('search-close').addEventListener('click', function () {
      modal.close();
    });
    modal.addEventListener('click', function (e) {
      if (e.target === modal) modal.close();
    });
    document.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        if (modal.open) modal.close();
        else openSearch();
      }
    });
  })();
</script>

<style is:global>
  /* Adaptar la UI de Pagefind a los tokens del sitio (claro/oscuro) */
  #search-modal {
    --pagefind-ui-primary: var(--primary);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background-elevated);
    --pagefind-ui-border: var(--border-color);
    --pagefind-ui-tag: var(--surface);
    --pagefind-ui-scale: 0.9;
    /* Mundo pixel: sin redondeos y borde marcado en el input */
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-image-border-radius: 0;
    --pagefind-ui-border-width: 2px;
    --pagefind-ui-font: var(--font-sans);
  }

  /* Resaltado del término: destacador ámbar (el color que los buscadores
     llevan décadas enseñando), con el octágono de los tags */
  #search-modal mark {
    background-color: var(--warning-fill);
    color: var(--background);
    padding: 0 3px;
    clip-path: polygon(
      2px 0, calc(100% - 2px) 0, 100% 2px,
      100% calc(100% - 2px), calc(100% - 2px) 100%,
      2px 100%, 0 calc(100% - 2px), 0 2px
    );
  }

  /* Contador de resultados en mono */
  #search-modal .pagefind-ui__message {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--secondary);
    padding: 0;
  }

  /* Cada resultado es una card pixel */
  #search-modal .pagefind-ui__result {
    border: 2px solid var(--border-color);
    background-color: var(--card-bg);
    padding: 0.8rem 0.95rem;
    margin: 0.9rem 0;
  }

  /* Título del resultado: tinta (es título); los sub-enlaces van en azul */
  #search-modal .pagefind-ui__result-link {
    color: var(--foreground);
    font-weight: 700;
  }

  #search-modal .pagefind-ui__result-link:hover {
    color: var(--primary);
  }

  #search-modal .pagefind-ui__result-nested .pagefind-ui__result-link {
    color: var(--primary);
    font-weight: 600;
  }

  #search-modal .pagefind-ui__result-excerpt {
    color: var(--secondary);
  }

  /* Sub-resultados: viñeta ▸ del sistema en vez de la flecha por defecto */
  #search-modal .pagefind-ui__result-nested .pagefind-ui__result-link::before {
    content: '▸ ';
    color: var(--secondary);
    position: static;
  }

  /* Botones de Pagefind (Limpiar / Cargar más) al lenguaje pixel */
  #search-modal .pagefind-ui__search-clear,
  #search-modal .pagefind-ui__button {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--secondary);
    background-color: var(--surface);
    border: 2px solid var(--border-color);
    border-radius: 0;
  }

  #search-modal .pagefind-ui__button {
    color: var(--foreground);
    box-shadow: var(--shadow-sm);
  }

  #search-modal .pagefind-ui__button:hover {
    border-color: var(--secondary);
    background-color: var(--surface);
  }

  #search-modal .pagefind-ui__button:active {
    translate: 2px 2px;
    box-shadow: none;
  }
</style>
