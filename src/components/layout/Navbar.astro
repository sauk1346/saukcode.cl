---
// Navbar estático con menú móvil y toggle de tema en JS vanilla.
// En Astro (MPA) los anchors /#seccion funcionan nativos: desaparece la
// lógica de sessionStorage + scrollIntoView del sitio Next.
const links = [
  { label: 'Programación', href: '/#programacion', external: false },
  { label: 'Sobre mí', href: 'https://www.antoniomorales.cl', external: true },
];
---

<header class="sticky top-0 z-50 border-b border-(--border-color) bg-(--background-elevated) shadow-sm">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4">
    <!-- Botón menú móvil -->
    <button
      id="mobile-menu-button"
      class="rounded-md p-2 text-(--foreground) hover:bg-(--surface) md:hidden"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>

    <a href="/" class="text-lg font-bold text-(--primary)">SaukCode</a>

    <!-- Menú escritorio -->
    <ul class="hidden items-center gap-6 md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="text-sm font-medium text-(--foreground) transition-colors hover:text-(--primary)"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <button
          class="theme-toggle rounded-md border border-(--border-color) p-2 hover:bg-(--surface)"
          aria-label="Cambiar tema"
        >
          <!-- Sol (visible en modo oscuro) -->
          <svg class="hidden size-4 dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5" />
            <path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
          </svg>
          <!-- Luna (visible en modo claro) -->
          <svg class="size-4 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
      </li>
    </ul>

    <!-- Toggle de tema en móvil (fuera del panel para acceso rápido) -->
    <button
      class="theme-toggle rounded-md border border-(--border-color) p-2 hover:bg-(--surface) md:hidden"
      aria-label="Cambiar tema"
    >
      <svg class="hidden size-4 dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5" />
        <path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
      </svg>
      <svg class="size-4 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </button>
  </nav>

  <!-- Panel menú móvil -->
  <div id="mobile-menu" class="hidden border-t border-(--border-color) bg-(--background-elevated) md:hidden">
    <ul class="flex flex-col gap-1 px-4 py-3">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="block rounded-md px-3 py-2 text-sm font-medium text-(--foreground) hover:bg-(--surface)"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script is:inline>
  // Toggle de tema (ambos botones comparten la clase .theme-toggle)
  document.querySelectorAll('.theme-toggle').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var el = document.documentElement;
      var dark = el.classList.toggle('dark');
      el.classList.toggle('dark-mode-override', dark);
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
    });
  });

  // Menú móvil
  var menuButton = document.getElementById('mobile-menu-button');
  var mobileMenu = document.getElementById('mobile-menu');
  menuButton.addEventListener('click', function () {
    var open = mobileMenu.classList.toggle('hidden');
    menuButton.setAttribute('aria-expanded', String(!open));
  });
  // Cerrar el panel al navegar a un anchor de la misma página
  mobileMenu.querySelectorAll('a').forEach(function (a) {
    a.addEventListener('click', function () {
      mobileMenu.classList.add('hidden');
      menuButton.setAttribute('aria-expanded', 'false');
    });
  });
</script>
