---
// Navbar estático con menú móvil y toggle de tema en JS vanilla.
// Chrome "16 bits": wordmark en Silkscreen, controles como cajas pixel.
// En Astro (MPA) los anchors /#seccion funcionan nativos.
const links = [
  { label: 'Programación', href: '/#programacion', external: false },
  { label: 'Sobre mí', href: 'https://www.antoniomorales.cl', external: true },
];
---

<header class="sticky top-0 z-50 border-b-2 border-(--border-color) bg-(--background-elevated)">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4">
    <!-- Botón menú móvil -->
    <button
      id="mobile-menu-button"
      class="pixel-press border-2 border-(--border-color) p-2 text-(--foreground) hover:bg-(--surface) md:hidden"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="square">
        <line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>

    <a href="/" class="font-pixel text-base font-bold tracking-tight text-(--foreground)">
      SAUK<span class="text-(--primary)">CODE</span>
    </a>

    <!-- Menú escritorio -->
    <ul class="hidden items-center gap-5 md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="text-sm font-bold text-(--foreground) transition-colors hover:text-(--primary)"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <button
          class="js-open-search pixel-press flex items-center gap-2 border-2 border-(--border-color) bg-(--surface) px-3 py-1.5 text-sm text-(--secondary) shadow-(--shadow-sm) hover:text-(--foreground)"
          aria-label="Buscar en el sitio"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
            <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
          </svg>
          Buscar
          <kbd class="font-mono border border-(--border-color) bg-(--background) px-1 text-[10px]">Ctrl K</kbd>
        </button>
      </li>
      <li>
        <button
          class="theme-toggle pixel-press border-2 border-(--border-color) bg-(--surface) p-2 shadow-(--shadow-sm) hover:text-(--primary)"
          aria-label="Cambiar tema"
        >
          <!-- Sol (visible en modo oscuro) -->
          <svg class="hidden size-4 dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="square">
            <circle cx="12" cy="12" r="5" />
            <path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
          </svg>
          <!-- Luna (visible en modo claro) -->
          <svg class="size-4 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="square">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
      </li>
    </ul>

    <!-- Buscar + toggle de tema en móvil (fuera del panel para acceso rápido) -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        class="js-open-search pixel-press border-2 border-(--border-color) bg-(--surface) p-2"
        aria-label="Buscar en el sitio"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
          <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
        </svg>
      </button>
      <button
        class="theme-toggle pixel-press border-2 border-(--border-color) bg-(--surface) p-2"
        aria-label="Cambiar tema"
      >
        <svg class="hidden size-4 dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="square">
          <circle cx="12" cy="12" r="5" />
          <path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
        </svg>
        <svg class="size-4 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="square">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Panel menú móvil -->
  <div id="mobile-menu" class="hidden border-t-2 border-(--border-color) bg-(--background-elevated) md:hidden">
    <ul class="flex flex-col gap-1 px-4 py-3">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="block px-3 py-2 text-sm font-bold text-(--foreground) hover:bg-(--surface)"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script is:inline>
  // Toggle de tema (ambos botones comparten la clase .theme-toggle)
  document.querySelectorAll('.theme-toggle').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var el = document.documentElement;
      var dark = el.classList.toggle('dark');
      el.classList.toggle('dark-mode-override', dark);
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
    });
  });

  // Menú móvil
  var menuButton = document.getElementById('mobile-menu-button');
  var mobileMenu = document.getElementById('mobile-menu');
  menuButton.addEventListener('click', function () {
    var open = mobileMenu.classList.toggle('hidden');
    menuButton.setAttribute('aria-expanded', String(!open));
  });
  // Cerrar el panel al navegar a un anchor de la misma página
  mobileMenu.querySelectorAll('a').forEach(function (a) {
    a.addEventListener('click', function () {
      mobileMenu.classList.add('hidden');
      menuButton.setAttribute('aria-expanded', 'false');
    });
  });
</script>
