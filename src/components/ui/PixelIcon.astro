---
// Iconos sprite propios (ver pixelIcons.js), renderizados con crispEdges.
// Usan currentColor, así que se tiñen con el texto que los rodea.
// El tamaño debe ser múltiplo de 16: con escala no entera, crispEdges
// redondea y los píxeles salen desparejos (el dibujo se deforma).
import { pixelIconPath } from './pixelIcons.js';

const { name, size = 32, class: cls = '' } = Astro.props;
const d = pixelIconPath(name);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="currentColor"
  shape-rendering="crispEdges"
  aria-hidden="true"
  class={cls}
>
  <path d={d}></path>
</svg>
