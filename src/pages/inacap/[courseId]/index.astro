---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseDetails from '../../../components/features/inacap/CourseDetails.jsx';
import { getCourseData, getAllCourseIds } from '../../../utils/courseUtils.js';

export function getStaticPaths() {
  // ti3v12 tiene página custom (ti3v12.astro), igual que en Next
  return getAllCourseIds()
    .filter((courseId) => courseId !== 'ti3v12')
    .map((courseId) => ({ params: { courseId } }));
}

const { courseId } = Astro.params;
const courseData = getCourseData(courseId);

// Tinte del área del ramo (etiqueta de cartucho, cuadros de unidad)
const { subjects } = await import('../../../data/inacap/inacapData.js');
const category = subjects.find((s) => s.href === `/inacap/${courseId}`)?.category ?? 'general';
---

<BaseLayout
  title={`${courseData.courseCode} | INACAP`}
  description={courseData.courseDescription}
>
  <div style={`--course-accent: var(--cat-${category}); --course-accent-fill: var(--cat-${category}-fill)`}>
    <CourseDetails client:load {...courseData} />
  </div>
</BaseLayout>
