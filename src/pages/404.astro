---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 | SaukCode" description="Página no encontrada">
  <div class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="font-pixel mb-6 text-4xl font-bold text-(--error) sm:text-5xl">GAME OVER</p>
    <p class="font-mono mb-2 text-sm text-(--secondary)">error 404</p>
    <p class="mb-10 text-(--foreground)">Tus apuntes están en otro castillo.</p>
    <a href="/" class="pixel-press press-start font-pixel inline-block px-6 py-3 text-sm">
      ▶ CONTINUAR
    </a>
    <p class="mt-6 text-sm text-(--secondary)">
      O prueba el buscador: <kbd class="font-mono border border-(--border-color) bg-(--surface) px-1.5 py-0.5 text-xs">Ctrl K</kbd>
    </p>
  </div>
</BaseLayout>

<style>
  /* Botón PRESS START: ficha biselada en octágono que late con el reloj
     global px-blink, como los "INSERT COIN / PRESS START" de arcade */
  .press-start {
    background-color: var(--primary);
    color: var(--background);
    clip-path: polygon(
      3px 0, calc(100% - 3px) 0, 100% 3px,
      100% calc(100% - 3px), calc(100% - 3px) 100%,
      3px 100%, 0 calc(100% - 3px), 0 3px
    );
    box-shadow:
      inset 3px 3px 0 rgba(255, 255, 255, 0.3),
      inset -3px -3px 0 rgba(0, 0, 0, 0.28);
    filter: drop-shadow(3px 3px 0 var(--shadow-hard));
  }

  :global(html[data-blink='1']) .press-start,
  :global(html[data-blink='3']) .press-start {
    opacity: 0.8;
  }

  :global(html[data-blink='2']) .press-start {
    opacity: 0.6;
  }

  .press-start:active {
    filter: drop-shadow(1px 1px 0 var(--shadow-hard));
  }
</style>
