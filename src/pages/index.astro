---
// Portada: hero con el buscador como acción principal, "Continuar" (la última
// lección vista, guardada por LessonLayout en localStorage) y fichas de ramos
// con datos reales calculados en el build.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelIcon from '../components/ui/PixelIcon.astro';
import { getAllInacapLessonPaths } from '../utils/courseUtils.js';
import { subjects } from '../data/inacap/inacapData.js';
import { problems as leetcodeProblems } from '../data/ejercicios/leetcode/problems.js';
import { problems as javaProblems } from '../data/ejercicios/java/problems.js';

// Solo cuentan las lecciones publicadas: slug registrado ∩ MDX existente
// (los paths registrados incluyen PDFs/videos que no son lecciones)
const entries = await getCollection('inacap');
const published = new Set(entries.map((e) => e.id.replace(/\.mdx$/, '')));
const lessonPaths = getAllInacapLessonPaths().filter(({ courseId, slug }) =>
  published.has(`${courseId}/${slug}`)
);
const lessonsByCourse = {};
for (const { courseId } of lessonPaths) {
  lessonsByCourse[courseId] = (lessonsByCourse[courseId] ?? 0) + 1;
}

// Solo los ramos con apuntes publicados, agrupados por semestre (reciente primero)
const courses = subjects
  .filter((s) => s.href)
  .map((s) => ({ ...s, lessons: lessonsByCourse[s.href.split('/').pop()] ?? 0 }))
  .filter((s) => s.lessons > 0);

const semesters = [...new Set(courses.map((s) => s.semester))].sort((a, b) => b - a);
// El semestre más reciente es el que está en curso: acceso rápido desde la home
const currentSemester = semesters.length
  ? {
      n: semesters[0],
      year: courses.find((s) => s.semester === semesters[0])?.year,
      courses: courses.filter((s) => s.semester === semesters[0]),
    }
  : null;

const totalLessons = lessonPaths.length;
const totalLeetcode = Object.keys(leetcodeProblems).length;
const totalJava = Object.keys(javaProblems).length;
---

<BaseLayout title="SaukCode" description="Apuntes de Ingeniería en Informática (INACAP), ejercicios de programación resueltos y flashcards de estudio.">
  <!-- Hero -->
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-12 text-center">
    <h1 class="font-pixel text-3xl text-(--foreground) sm:text-4xl">Apuntes de Informática</h1>
    <p class="mx-auto mt-4 max-w-xl text-(--secondary)">
      {totalLessons} lecciones de Ingeniería en Informática (INACAP), {totalLeetcode
        + totalJava} ejercicios de programación resueltos y flashcards para estudiar.
    </p>

    <!-- Buscador: la acción principal (abre el modal de Pagefind) -->
    <button
      class="js-open-search pixel-press font-mono mx-auto mt-8 flex w-full max-w-xl items-center gap-3 border-2 border-(--foreground) bg-(--background-elevated) px-4 py-3 text-left text-sm text-(--secondary) shadow-(--shadow-md)"
      aria-label="Buscar en el sitio"
    >
      <span aria-hidden="true" class="text-(--primary)">▸</span>
      Buscar en los apuntes
      <span aria-hidden="true" class="hero-cursor -ml-2 inline-block w-[0.6em] bg-(--primary)">&nbsp;</span>
    </button>

    <!-- Ranura de partida guardada (la llena el script si hay save state) -->
    <a
      id="continue-link"
      href="/"
      class="save-slot pixel-press group mx-auto mt-4 hidden w-full max-w-xl items-center gap-3 border-2 border-(--border-color) bg-(--surface) px-4 py-2.5 text-left text-sm shadow-(--shadow-sm)"
    >
      <span class="font-pixel text-xs text-(--primary)">
        <span class="save-cursor" aria-hidden="true">▶</span> CONTINUAR
      </span>
      <span id="continue-title" class="truncate text-(--foreground) group-hover:text-(--primary)"></span>
      <span class="font-mono ml-auto hidden text-[10px] text-(--secondary) sm:inline">SAVE 01</span>
    </a>
  </section>

  <!-- Secciones: la home es un hub, cada ficha entra a su sección completa -->
  <section id="programacion" class="mx-auto max-w-5xl px-4 py-10">
    <h2 class="font-pixel text-xl text-(--foreground)">Secciones</h2>
    <p class="mt-1 mb-8 text-sm text-(--secondary)">Todo el contenido, por área</p>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <a href="/inacap" class="pixel-press pixel-box group block bg-(--card-bg) p-5">
        <span class="flex items-center gap-2 text-(--primary)">
          <PixelIcon name="birrete" />
          <span class="font-mono text-xs">INACAP</span>
        </span>
        <span class="mt-1 block text-lg font-bold text-(--foreground) group-hover:text-(--primary)">
          Ingeniería en Informática
        </span>
        <span class="mt-2 block text-sm text-(--secondary)">
          {courses.length} ramos con apuntes en {semesters.length} semestres, {totalLessons} clases.
          Incluye el calendario académico y las flashcards.
        </span>
      </a>

      <a href="/ejercicios" class="pixel-press pixel-box group block bg-(--card-bg) p-5">
        <span class="flex items-center gap-2 text-(--primary)">
          <PixelIcon name="codigo" />
          <span class="font-mono text-xs">EJERCICIOS</span>
        </span>
        <span class="mt-1 block text-lg font-bold text-(--foreground) group-hover:text-(--primary)">
          Programación resuelta
        </span>
        <span class="mt-2 block text-sm text-(--secondary)">
          {totalLeetcode} problemas de LeetCode y {totalJava} ejercicios de Java,
          con solución comentada.
        </span>
      </a>
    </div>

    <!-- Acceso rápido al semestre en curso (lo que se estudia hoy) -->
    {currentSemester && (
      <div class="mt-8">
        <h3 class="font-mono mb-3 text-sm text-(--secondary)">
          Semestre {currentSemester.n} ({currentSemester.year}) — en curso
        </h3>
        <div class="flex flex-wrap gap-2">
          {currentSemester.courses.map((c) => (
            <a
              href={c.href}
              class="pixel-press border-2 border-(--border-color) bg-(--background-elevated) px-3 py-1.5 text-sm font-bold text-(--foreground) shadow-(--shadow-sm) hover:text-(--primary)"
            >
              {c.name}
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  /* El cursor del save slot late con el reloj global */
  :global(html[data-blink='1']) .save-cursor,
  :global(html[data-blink='3']) .save-cursor {
    opacity: 0.6;
  }

  :global(html[data-blink='2']) .save-cursor {
    opacity: 0.25;
  }

  .hero-cursor {
    animation: hero-blink 1.1s steps(2) infinite;
  }
  @keyframes hero-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cursor {
      animation: none;
    }
  }
</style>

<script is:inline>
  // Save state: si hay una última lección guardada, mostrar "Continuar"
  (function () {
    try {
      var saved = JSON.parse(localStorage.getItem('saukcode:ultima-leccion') || 'null');
      if (!saved || !saved.url || !saved.title) return;
      var link = document.getElementById('continue-link');
      link.href = saved.url;
      document.getElementById('continue-title').textContent = saved.title;
      link.classList.remove('hidden');
      link.classList.add('flex');
    } catch (e) {}
  })();
</script>
